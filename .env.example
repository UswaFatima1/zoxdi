# Zoxdi environment
# Copy to `.env.local` for local dev, and set the same values in your host's
# build settings (Cloudflare Pages → Settings → Environment variables).
# Every value is public and baked into the static build — never put secrets here.

# ---- Supabase: accounts + saved progress -----------------------------------
# Project Settings → API → Project URL, and the "anon / public" key.
# Fill both to store accounts and progress in your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Google Analytics 4: page views + engagement events --------------------
# GA4 → Admin → Data streams → your web stream → Measurement ID (G-XXXXXXX).
# Leave blank to disable Google Analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Cloudflare Web Analytics: visitor and pageview counts -----------------
# Cloudflare dashboard → Analytics & Logs → Web Analytics → add a site → copy
# the beacon token. Leave blank to disable analytics entirely.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
